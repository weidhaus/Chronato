<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- For `xcodebuild -exportArchive` in scripts/ios-release.sh: re-sign for the
     App Store and upload the build to App Store Connect (TestFlight).
     The build number is the archive's own (the script sets a unique one), so
     Xcode is told not to change it on upload. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>5SB3S8ESR3</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
